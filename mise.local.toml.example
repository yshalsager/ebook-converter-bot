# Copy to mise.local.toml (gitignored) and fill in. mise loads these into the environment.
[env]
TG_BOT_TOKEN = "11111111:xxxxxxxxxxxxxxxxxx"
API_KEY = "1121221"
API_HASH = "xxxxxxxxxxxxxxxxxxxx"
TG_BOT_ADMINS = "2222222"  # comma-separated user ids
FREE_USERS = ""  # comma-separated user ids exempt from the monthly limit
PAYMENTS_ENABLED = "false"
# TEST_DC = "true"  # use Telegram's test environment
